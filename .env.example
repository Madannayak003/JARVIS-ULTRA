# Copy this file to .env and set local values as needed.
# Never commit the real .env file.

GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
# xAI / Grok
XAI_API_KEY=
YOUTUBE_API_KEY=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Leave blank to preserve the built-in Ollama defaults.
OLLAMA_API_URL=
JARVIS_ESP32_IP=
JARVIS_LIVE_MODEL=
# Set to 1 only when provider/voice/transport diagnostics are needed.
JARVIS_DEBUG=0

# Android / ADB bridge. The bridge also checks PATH and C:\\platform-tools\\adb.exe.
ANDROID_ADB_PATH=
ANDROID_DEVICE_ID=
ANDROID_DEFAULT_PAYMENT_APP=
# Optional private-VPN ADB fallback. Leave blank to preserve local/USB-only behavior.
ANDROID_CONNECTION_MODE=AUTO
ANDROID_REMOTE_HOST=
ANDROID_REMOTE_PORT=5555

# Optional private-VPN address advertised in the Dashboard QR pairing URL.
# The DashboardServer still uses its existing private/LAN binding behavior.
JARVIS_REMOTE_HOST=

# Local face recognition (samples remain inside data/faces/)
JARVIS_VISION_FACE_RECOGNITION_THRESHOLD=75
JARVIS_VISION_FACE_MIN_SIZE=80
JARVIS_VISION_FACE_MIN_QUALITY=0.20
JARVIS_VISION_REGISTRATION_SAMPLE_COUNT=5
JARVIS_VISION_REGISTRATION_MAX_ATTEMPTS=30
JARVIS_VISION_REGISTRATION_SAMPLE_INTERVAL=0.25
JARVIS_VISION_SPEECH_COOLDOWN=5

PERSONAL_GITHUB_URL=
PERSONAL_GITHUB_PROFILE_URL=
PERSONAL_GITHUB_REPOSITORIES_URL=
PERSONAL_FACEBOOK_URL=
PERSONAL_FACEBOOK_PROFILE_URL=
PERSONAL_LINKEDIN_URL=
PERSONAL_LINKEDIN_PROFILE_URL=
PERSONAL_WEBSITE_URL=
PERSONAL_PORTFOLIO_URL=
PERSONAL_IOT_URL=
PERSONAL_IOT_WEBSITE_URL=
JARVIS_GITHUB_URL=
JARVIS_REPOSITORY_URL=

# Optional browser overrides; blank values preserve existing defaults.
JARVIS_BROWSER_CDP_HOST=
JARVIS_BROWSER_CDP_PORT=
JARVIS_BROWSER_EXECUTABLE=
JARVIS_BROWSER_PROFILE_DIR=
